{
  "name": "birthday-qr-memory-system",
  "version": "1.0.0",
  "description": "Interactive 8-QR Code Birthday Memory System with Scrapbook Poster Integration, Public Memory Pages, and Admin Dashboard",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "node scripts/setup.js",
    "generate-qrs": "node scripts/generate-qrs.js",
    "verify": "node scripts/verify.js",
    "poster:calibrate": "node scripts/calibrate-poster-boxes.js public/assets/poster-v4/template.jpg",
    "poster:preview": "node scripts/preview-poster-frames.js public/assets/poster-v4/template.jpg public/assets/poster-v4/template-boxes.json --scale=2 --out=poster-preview.png",
    "poster:verify": "node scripts/verify-poster-studio.js public/poster-v4.html public/assets/poster-v4/template.jpg public/assets/poster-v4/template-boxes.json",
    "poster:test": "node scripts/test-poster-studio.js public/poster-v4.html",
    "poster:check": "npm run poster:calibrate --silent && npm run poster:verify --silent && npm run poster:test --silent"
  },
  "keywords": [
    "birthday",
    "qr-code",
    "memory-system",
    "scrapbook",
    "interactive-poster"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jimp": "^0.22.12",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "jsdom": "^30.1.0"
  }
}
